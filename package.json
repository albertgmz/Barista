{
  "name": "barista",
  "version": "0.5.0",
  "description": "Industrial label designer and print application",
  "main": "./out/main/index.js",
  "author": {
    "name": "Albert Gomez"
  },
  "license": "GPL-3.0-only",
  "private": true,
  "scripts": {
    "postinstall": "install-electron",
    "predev": "npm run resources:generate",
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "prebuild": "npm run resources:generate",
    "build": "npm run typecheck && electron-vite build",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,json}\"",
    "licenses:audit": "node scripts/audit-licenses.mjs",
    "licenses:generate": "node scripts/generate-licenses.mjs",
    "licenses:check": "node scripts/generate-licenses.mjs --check",
    "resources:generate": "node scripts/generate-build-info.mjs && npm run licenses:generate",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate --config=drizzle.sqlite.config.ts && drizzle-kit generate --config=drizzle.mysql.config.ts && drizzle-kit generate --config=drizzle.postgresql.config.ts",
    "test:data:servers": "node scripts/test-data-servers.mjs",
    "data:test:up": "docker compose -f docs/docker-compose.data.yml up -d --wait",
    "data:test:down": "docker compose -f docs/docker-compose.data.yml down",
    "package:installer": "npm run build && electron-builder --win nsis --x64",
    "package:portable": "npm run build && electron-builder --win portable --x64",
    "dist": "npm run build && electron-builder --win nsis portable --x64"
  },
  "dependencies": {
    "@fluentui/react-components": "^9.74.7",
    "@fluentui/react-icons": "^2.0.341",
    "busboy": "^1.6.0",
    "bwip-js": "^4.11.4",
    "dockview-react": "^8.3.1",
    "drizzle-orm": "^1.0.0-rc.4",
    "electron-updater": "^6.8.9",
    "fabric": "^7.4.0",
    "fflate": "^0.8.3",
    "fontkit": "^2.0.4",
    "koffi": "^3.3.1",
    "mysql2": "^3.24.4",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "ws": "^8.21.3",
    "xlsx": "file:vendor/xlsx-0.20.3.tgz",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/busboy": "^1.5.4",
    "@types/fontkit": "^2.0.9",
    "@types/node": "^26.6.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.2.0",
    "drizzle-kit": "^1.0.0-rc.4",
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "playwright-core": "^1.63.0",
    "prettier": "^3.9.8",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^7.3.6",
    "vitest": "^5.0.1"
  }
}
